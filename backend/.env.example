# Copy to .env and adjust. Never commit real secrets (docs/17_SECURITY.md).
BIS_ENVIRONMENT=dev
BIS_LOG_LEVEL=INFO
# --- Hosting decision (cloud to spare local RAM) ---
# Postgres (Supabase, pgvector included): paste the pooler connection string.
#   Supabase dashboard → Project Settings → Database → Connection string (pooler, port 6543)
BIS_DATABASE_URL=postgresql+psycopg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Redis (Upstash): paste the Redis URL (rediss://...).
#   Upstash console → Redis database → Endpoints → Redis URL
BIS_REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379
BIS_S3_ENDPOINT_URL=http://localhost:9000
# Stage 3+ (OD-007): OpenRouter (OpenAI-compatible) + free providers.
#   Get a key at https://openrouter.ai/keys (free models have :free suffix).
#   Model is your pick per query budget, e.g. any current free instruct model.
BIS_LLM_BASE_URL=https://openrouter.ai/api/v1
BIS_LLM_API_KEY=
BIS_LLM_MODEL=
BIS_EMBEDDING_MODEL=BAAI/bge-m3
BIS_EMBEDDING_DIM=1024
